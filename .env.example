# Database (dev compose)
DB_PASSWORD=ragui_dev

# Production-only
# Browser-facing URL of the backend API.
#   - Without nginx proxy:  http://<host>:8000
#   - With nginx profile:   http://yourdomain.com  (port 80/443)
PUBLIC_API_URL=http://localhost:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
MAX_UPLOAD_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:3000

# Security (recommended for any deployment beyond localhost)
# Shared bearer token protecting every API route except /api/health.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# When set, enter it once in the app's Settings > Connection.
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=120

# Port bindings for the prod stack. Defaults keep everything on the host's
# loopback so only nginx (profile "with-proxy") faces the network.
# Set to 0.0.0.0 only when NOT using the nginx proxy on a remote machine.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# Backend uvicorn workers. Each worker keeps its own copy of loaded local
# embedding models in RAM — use 1 on small hosts (default).
WEB_CONCURRENCY=1
